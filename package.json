{
  "name": "haazir",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!@haazir/site",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @haazir/db generate",
    "db:migrate": "pnpm --filter @haazir/db migrate",
    "db:seed": "pnpm --filter @haazir/db seed",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "whatsapp:connect": "pnpm --filter @haazir/db connect-whatsapp",
    "whatsapp:mock": "pnpm --filter @haazir/api mock-graph",
    "whatsapp:simulate": "pnpm --filter @haazir/api simulate-webhook",
    "knowledge:add": "pnpm --filter @haazir/worker knowledge add",
    "knowledge:reindex": "pnpm --filter @haazir/worker knowledge reindex",
    "knowledge:list": "pnpm --filter @haazir/worker knowledge list",
    "bot:ask": "pnpm --filter @haazir/worker ask",
    "evals": "pnpm --filter @haazir/evals evals",
    "push:keys": "pnpm --filter @haazir/api push-keys",
    "admin:create": "pnpm --filter @haazir/api create-admin"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "turbo": "^2.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
